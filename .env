# Crypto Fraud Attribution System — Environment Variables
# Copy this file to .env and fill in your values

# Etherscan API key (leave empty to use demo mode with sample data)
ETHERSCAN_API_KEY=

# Mode: "demo" uses bundled sample data, "live" uses Etherscan API
MODE=demo

# Maximum trace depth (number of hops from suspect wallet)
MAX_TRACE_DEPTH=3

# Maximum transactions to fetch per address
MAX_TX_PER_ADDRESS=50
